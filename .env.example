LLM_BASE_URL=https://api.openai-proxy.org
LLM_MODEL=deepseek-v4.1-flash
LLM_API_KEY=
LLM_TIMEOUT=120
# Optional. Leave empty for local use. Required when exposing the app to a network.
SDR_ACCESS_TOKEN=
# The default is the sibling material folder; can point to another local directory.
SDR_RECORDINGS_DIR=
ASR_MODEL=small
ASR_DEVICE=cpu
ASR_CPU_THREADS=4
# Local ASR processing timeout in seconds, capped at 14400.
ASR_TIMEOUT=3600
# Optional Tavily search for company candidates; web results are not registry verification.
TAVILY_API_KEY=
